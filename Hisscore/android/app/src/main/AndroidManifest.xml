<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ requires this to show the daily-streak reminder. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Hisscore"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Challenge links: hisscore://c/XXXX-XXXX. Our own scheme,
                 so it always opens the app with nothing to verify. Most
                 chat apps will not make it tappable, which is what the
                 https filter below is for. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="hisscore"/>
            </intent-filter>
            <!-- The same challenge as an https link, which everything
                 linkifies.

                 android:autoVerify is deliberately absent. Verifying an
                 App Link needs /.well-known/assetlinks.json at the
                 DOMAIN ROOT - oasis-forge.github.io, not the project
                 page under /Hisscore/ - and the Play app-signing
                 fingerprint, which does not exist until the app is on
                 Play. Claiming autoVerify without those means Android
                 fails the check and hands the link to the browser
                 anyway. Until then the page at that address offers the
                 hisscore:// link, and a player who turns on "Open
                 supported links" for Hisscore gets the app directly.
                 See RELEASE.md. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="oasis-forge.github.io"
                    android:pathPrefix="/Hisscore/c"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
